# Jianghu Bot Environment Variables
# Gunakan file ini sebagai template. Copy menjadi .env dan isi nilainya.

# --- DISCORD BOT ---
# Token dari Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN_HERE"

# Client ID dari Discord Developer Portal (General Information -> Application ID)
CLIENT_ID="YOUR_APPLICATION_ID_HERE"
# DISCORD_CLIENT_ID harus sama persis dengan CLIENT_ID (digunakan oleh web-api auth)
DISCORD_CLIENT_ID="YOUR_APPLICATION_ID_HERE"
# Client Secret dari Discord Developer Portal (OAuth2 -> Client Secret)
DISCORD_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"

# ID Server (Guild ID) di mana bot berjalan
GUILD_ID="YOUR_GUILD_ID_HERE"

# --- DATABASE ---
# MongoDB Connection String (misal dari MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/jianghu"

# --- WEB API (BACKEND) ---
# Port untuk web API server
API_PORT=3001

# Secret untuk men-generate JWT (bebas, string random yang panjang)
JWT_SECRET="your-very-secure-jwt-secret-key-change-this"

# --- LAIN-LAIN ---
# Array ID Discord Owner (dipisahkan koma, opsional jika diperlukan untuk command khusus)
OWNER_IDS="ID_OWNER_1,ID_OWNER_2"

# Timezone untuk cron jobs/logging
TZ_NAME="Asia/Jakarta"