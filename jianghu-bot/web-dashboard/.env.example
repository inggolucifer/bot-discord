# Jianghu Web Dashboard Environment Variables
# Gunakan file ini sebagai template. Copy menjadi .env.local dan isi nilainya.

# Base URL untuk web dashboard frontend
# Di environment local biasanya http://localhost:3000
NEXT_PUBLIC_URL="http://localhost:3000"

# Base URL untuk backend API
# Di environment local biasanya berjalan di port 3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Client ID Aplikasi Discord (General Information -> Application ID)
# Nilai ini HARUS SAMA PERSIS dengan CLIENT_ID / DISCORD_CLIENT_ID di root .env
NEXT_PUBLIC_DISCORD_CLIENT_ID="YOUR_APPLICATION_ID_HERE"